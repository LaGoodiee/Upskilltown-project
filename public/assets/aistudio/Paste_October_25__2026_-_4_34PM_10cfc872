<title>Upskilltown Agency</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='32' fill='%23FF4800'/%3E%3Cpath d='M28 46V57A22 22 0 0 0 72 57V26M56 42L72 26L88 42' stroke='%23FFF' stroke-width='13' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='28' cy='25' r='8' fill='%2314110F'/%3E%3C/svg%3E">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700;800&display=swap">
<style>
:root{--bg:#f3f2ef;--fg:#111;--mut:#8b8a85;--card:#fff;--line:#e2e0da;--o:#ff4800;--o2:#d1330a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c0b0a;--fg:#f3f2ef;--mut:#8f8d87;--card:#171615;--line:#2a2826;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0c0b0a;--fg:#f3f2ef;--mut:#8f8d87;--card:#171615;--line:#2a2826;color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
body{margin:0;min-height:100%;background:var(--bg);color:var(--fg);font:400 16px/1.55 "Inter Tight",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;overflow-x:hidden;transition:background .4s,color .4s}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--o);outline-offset:3px}
.w{width:min(1200px,100% - 32px);margin-inline:auto}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;gap:12px;height:64px}
.logo{font-weight:800;letter-spacing:-.04em;font-size:20px;display:flex;align-items:center;gap:8px;margin-right:auto}
.lw{display:grid;line-height:1}.lw b{font-size:21px;font-weight:800;letter-spacing:-.05em}.lw small{font-size:8px;font-weight:700;letter-spacing:.5em;color:var(--o);margin-top:4px}
nav{display:flex;gap:4px}
nav a{padding:9px 16px;border-radius:99px;font-weight:500;font-size:15px;color:var(--mut);transition:.25s}
nav a:hover,nav a.on{background:var(--card);color:var(--fg)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 22px;border-radius:99px;border:1px solid var(--line);background:var(--card);font-weight:700;cursor:pointer;transition:transform .25s,box-shadow .25s,background .25s}
.btn:hover{transform:translateY(-3px)}
.btn.p{background:var(--o);border-color:var(--o);color:#fff}
.btn.p:hover{box-shadow:0 10px 30px rgba(255,106,0,.4)}
.btn.k{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.btn[disabled]{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}
#tg,#mb{width:44px;padding:0}
#mb{display:none}
.pg{display:none;padding-bottom:70px}.pg.on{display:block}
h1,h2,h3{letter-spacing:-.045em;line-height:.98;margin:0}
h1{font-size:clamp(40px,8.4vw,104px);font-weight:700}
h2{font-size:clamp(30px,5vw,60px);font-weight:700}
h3{font-size:22px;letter-spacing:-.03em;line-height:1.1}
.g{color:var(--mut)}
.hero{position:relative;padding:clamp(40px,8vw,90px) 0 40px;overflow:hidden}
.hero::before{content:"";position:absolute;width:min(640px,90vw);aspect-ratio:1;right:-10%;top:-10%;border-radius:50%;background:radial-gradient(circle,rgba(255,106,0,.55),rgba(209,51,10,.25) 45%,transparent 70%);filter:blur(30px);animation:fl 9s ease-in-out infinite alternate;z-index:-1}
@keyframes fl{to{transform:translate(-8%,10%) scale(1.15)}}
.ln{display:block;overflow:hidden}
.ln>span{display:inline-block;transform:translateY(105%);animation:up .9s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:calc(var(--i)*.12s)}
@keyframes up{to{transform:none}}
.sub{max-width:560px;font-size:clamp(16px,2vw,19px);color:var(--mut);margin:26px 0}
.row{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.glass{position:absolute;right:0;bottom:30px;padding:18px 22px;border-radius:24px;background:color-mix(in srgb,var(--card) 70%,transparent);border:1px solid var(--line);backdrop-filter:blur(12px);animation:fl 6s ease-in-out infinite alternate}
.glass b{font-size:44px;letter-spacing:-.05em;color:var(--o);line-height:1;display:block}
.glass span{font-size:13px;color:var(--mut)}
.mq{overflow:hidden;border-block:1px solid var(--line);padding:16px 0;margin:30px 0}
.mq div{display:flex;gap:40px;width:max-content;animation:mq 26s linear infinite;font-size:clamp(22px,3vw,34px);font-weight:700;letter-spacing:-.04em}
.mq span{white-space:nowrap}.mq span:nth-child(even){color:var(--o)}
@keyframes mq{to{transform:translateX(-50%)}}
.pills{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:50px 0}
.pills div{border-radius:99px;padding:clamp(16px,3.5vw,38px) 8px;text-align:center;font-weight:600;font-size:clamp(16px,3vw,32px);background:var(--card);border:1px solid var(--line)}
.pills .a{background:linear-gradient(135deg,#e8853d,var(--o2));color:#fff;border:0}
.pills .b{background:#000;color:#fff}.pills .c{color:var(--mut)}
.sec{padding:clamp(40px,7vw,80px) 0}
.tag{display:inline-block;padding:6px 14px;border-radius:99px;background:var(--card);border:1px solid var(--line);font-size:13px;font-weight:500;margin-bottom:18px}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:28px;padding:28px;transition:transform .35s,border-color .35s}
.card:hover{transform:translateY(-6px);border-color:var(--o)}
.card .e{font-size:34px;margin-bottom:60px;display:block}
.card p{color:var(--mut);margin:10px 0 0}
.price{font-size:clamp(38px,5vw,52px);font-weight:700;letter-spacing:-.05em;line-height:1;margin:22px 0 6px;color:var(--o)}
.was{color:var(--mut);text-decoration:line-through;font-size:18px}
.badge{display:inline-block;background:var(--o);color:#fff;border-radius:99px;padding:3px 12px;font-size:12px;font-weight:700;margin-left:8px}
.opts{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.opts button{min-height:40px;padding:0 16px;border-radius:99px;border:1px solid var(--line);background:transparent;cursor:pointer;font-weight:500;transition:.2s}
.opts button.on{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.steps{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:40px}
.trk{position:absolute;left:12%;right:12%;top:35px;border-top:2px dashed var(--line)}
.trk::after{content:"";position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:50%;background:var(--o);box-shadow:0 0 14px var(--o);animation:dot 8s linear infinite}
@keyframes dot{to{left:calc(100% - 12px)}}
.st{text-align:center;position:relative}
.ic{width:70px;height:70px;border-radius:50%;margin:0 auto 14px;display:grid;place-items:center;font-size:28px;background:var(--card);border:1px solid var(--line);animation:lit 8s infinite;animation-delay:calc(var(--i)*2s)}
@keyframes lit{0%,22%{transform:scale(1.15);background:var(--o);box-shadow:0 0 0 12px rgba(255,106,0,.18)}28%,100%{transform:none;background:var(--card);box-shadow:none}}
.st b{display:block;font-size:17px}.st small{color:var(--mut)}
.coin{position:absolute;right:6%;top:-8px;background:var(--o);color:#fff;font-weight:700;border-radius:99px;padding:4px 12px;font-size:14px;animation:pop 8s infinite;animation-delay:6s;opacity:0}
@keyframes pop{0%{opacity:0;transform:translateY(14px) scale(.7)}6%,20%{opacity:1;transform:none}26%,100%{opacity:0;transform:translateY(-20px)}}
form{display:grid;gap:14px;grid-template-columns:1fr 1fr}
form .f{grid-column:1/-1}
label{display:grid;gap:6px;font-size:14px;font-weight:500}
input,select,textarea{width:100%;min-height:48px;padding:12px 16px;border-radius:16px;border:1px solid var(--line);background:var(--bg)}
textarea{min-height:100px;resize:vertical}
.est{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-radius:18px;background:var(--bg);border:1px dashed var(--o);font-weight:700}
.est b{font-size:26px;color:var(--o);letter-spacing:-.04em;text-align:right}
.fx{display:block;font-size:13px;font-weight:500;letter-spacing:0;color:var(--mut);margin-top:6px}
.err{color:#d33;font-size:13px;min-height:18px;grid-column:1/-1}
details{border-bottom:1px solid var(--line);padding:18px 0}
summary{cursor:pointer;font-weight:700;font-size:19px;letter-spacing:-.02em;list-style:none;display:flex;justify-content:space-between}
summary::after{content:"+";color:var(--o);font-size:24px;transition:transform .3s}
details[open] summary::after{transform:rotate(45deg)}
details p{color:var(--mut);margin:10px 0 0;max-width:640px}
.xmas{border-radius:32px;padding:clamp(26px,5vw,56px);background:linear-gradient(135deg,var(--o),var(--o2) 70%,#6b0f00);color:#fff;position:relative;overflow:hidden}
.xmas::after{content:"🎁";position:absolute;right:5%;top:10%;font-size:clamp(70px,14vw,160px);animation:fl 4s ease-in-out infinite alternate;opacity:.9}
.xmas h2{max-width:640px}.xmas p{max-width:520px;opacity:.9}
.dash{display:none;margin-top:20px;padding:22px;border-radius:22px;background:var(--bg);border:1px solid var(--o)}
.dash.on{display:block}
.dash code{display:block;word-break:break-all;font-size:15px;padding:12px;border-radius:12px;background:var(--card);margin:8px 0 14px}
.rules li{margin:8px 0;color:var(--mut)}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:30px 0}
.pj .im{aspect-ratio:16/10;border-radius:20px;margin-bottom:18px;background:linear-gradient(135deg,color-mix(in srgb,var(--o) 30%,var(--card)),var(--card));display:grid;place-items:center;font-size:38px}
.pj .btn{margin-top:16px;min-height:40px}
.wa{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));z-index:25;width:58px;height:58px;border-radius:50%;background:#25d366;display:grid;place-items:center;font-size:28px;box-shadow:0 10px 30px rgba(0,0,0,.3);animation:pls 2.4s infinite}
@keyframes pls{0%{box-shadow:0 0 0 0 rgba(37,211,102,.6)}100%{box-shadow:0 0 0 22px rgba(37,211,102,0)}}
footer{border-top:1px solid var(--line);padding:30px 0 90px;color:var(--mut);font-size:14px}
.rv{opacity:0;transform:translateY(26px);transition:opacity .8s,transform .8s}.rv.in{opacity:1;transform:none}
.refp{display:none;margin-left:8px;font-size:12px;background:var(--o);color:#fff;border-radius:99px;padding:3px 10px}
@media(max-width:820px){
nav{position:absolute;top:64px;left:0;right:0;flex-direction:column;padding:12px 16px;background:var(--bg);border-bottom:1px solid var(--line);display:none}
nav.open{display:flex}nav a{padding:14px 16px}
#mb{display:inline-flex}.hdr-cta{display:none}
.steps{grid-template-columns:1fr 1fr;row-gap:34px}.trk{display:none}
form{grid-template-columns:1fr}.glass{position:static;display:inline-block;margin-top:10px}
.pills{gap:6px}}
.tc h3{margin:18px 0 10px}.tc .btn{margin-top:20px;min-height:40px}.pend{border-style:dashed;opacity:.8}
.who{display:flex;align-items:center;gap:12px;margin-top:22px}.av{width:42px;height:42px;border-radius:50%;background:var(--o);color:#fff;display:grid;place-items:center;font-weight:700;flex:none}
.mod{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.82);display:none;place-items:center;padding:20px}.mod.on{display:grid}.mod img{max-width:min(560px,100%);max-height:80vh;border-radius:18px;background:var(--card)}.mod .btn{position:absolute;top:max(16px,env(safe-area-inset-top,0px));right:16px}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.ln>span,.rv{transform:none;opacity:1}}
</style>
</head>
<body>
<header><div class="w nav">
<a class="logo" href="#offer" aria-label="Upskilltown Agency"><svg viewBox="0 0 100 100" width="40" height="40" aria-hidden="true"><rect width="100" height="100" rx="32" fill="#FF4800"/><path d="M28 46V57A22 22 0 0 0 72 57V26M56 42L72 26L88 42" stroke="#fff" stroke-width="13" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="28" cy="25" r="8" fill="#14110F"/></svg><span class="lw"><b>Upskilltown</b><small>AGENCY</small></span></a>
<nav id="nv"><a href="#offer" data-p="offer">Home</a><a href="#affiliates" data-p="affiliates">Affiliates</a><a href="#proof" data-p="proof">Proof of work</a></nav>
<a class="btn p hdr-cta" id="hc" target="_blank" rel="noopener">Order on WhatsApp</a>
<button class="btn" id="tg" aria-label="Toggle light and dark mode">🌓</button>
<button class="btn" id="mb" aria-label="Menu">☰</button>
</div></header>

<main>
<section class="pg" id="offer"><div class="w">
<div class="hero">
<span class="tag">Websites and landing pages for businesses</span>
<h1><span class="ln" style="--i:0"><span>We build websites</span></span><span class="ln" style="--i:1"><span>that make your brand</span></span><span class="ln" style="--i:2"><span class="g">look expensive.</span></span></h1>
<p class="sub">Landing pages, multi-page websites and portfolios that bring you clients. Pick a plan, tell us about your business, and we’ll finish the chat on WhatsApp.</p>
<div class="row"><button class="btn p" data-go="orderf">Start your project</button><button class="btn" data-go="pricing">View pricing</button></div>
<div class="glass"><b><span data-c="73">0</span>%</b><span>off today on landing pages</span></div>
</div>
<div class="mq" aria-hidden="true"><div id="mq"></div></div>
<div class="pills"><div>We</div><div class="a">Create</div><div class="b">→</div><div class="c">Future</div></div>

<div class="sec"><h2 class="rv">What we build</h2><div class="grid" style="margin-top:30px">
<div class="card rv"><span class="e">⚡</span><h3>Landing pages</h3><p>One focused page, built to turn visitors into customers.</p></div>
<div class="card rv"><span class="e">🗂️</span><h3>Multi-page websites</h3><p>A full business website with every page your brand needs.</p></div>
<div class="card rv"><span class="e">🎨</span><h3>Portfolio websites</h3><p>Show your work and get hired, on a site that looks the part.</p></div>
</div></div>

<div class="sec" id="pricing"><span class="tag">Pricing in naira</span><h2 class="rv">Limited offer prices</h2><div class="grid" id="pc" style="margin-top:30px"></div><p class="g" style="font-size:13px;margin-top:16px">Dollar, shilling and cedi amounts are approximate, based on mid-2026 exchange rates. Naira prices are exact, and final amounts are confirmed on WhatsApp.</p></div>

<div class="sec"><h2 class="rv">How booking works</h2><div class="steps rv" id="s1"></div></div>

<div class="sec" id="orderf"><div class="card"><h2>Start your project</h2><p class="g">Fill this in and we’ll open WhatsApp with your details ready to send.</p>
<form id="of" novalidate style="margin-top:24px">
<label>Your name<input id="o_n" autocomplete="name"></label>
<label>WhatsApp number<input id="o_p" inputmode="tel" autocomplete="tel"></label>
<label>Service<select id="o_s"></select></label>
<label>Domain<select id="o_d"></select></label>
<label>Business name<input id="o_b"></label>
<label>Deadline<input id="o_dl" placeholder="e.g. 1 week"></label>
<label class="f">Tell us about your business<textarea id="o_m"></textarea></label>
<label class="f">Referred by an affiliate? (optional)<input id="o_r" placeholder="Affiliate’s name"></label>
<div class="est"><span>Estimated price</span><b id="o_e"></b></div>
<div class="err" id="o_x"></div>
<button class="btn p f" type="submit">Send on WhatsApp</button>
</form></div></div>

<div class="sec" id="tm"><span class="tag">Client feedback</span><h2 class="rv">Don’t just take our word for it.</h2><p class="g" style="max-width:520px;margin:14px 0 0">Real feedback from clients we’ve built for, with proof you can open.</p><div class="grid" id="tl" style="margin-top:30px"></div></div>
<div class="sec"><h2 class="rv">Questions</h2><div style="margin-top:20px">
<details><summary>How do I order?</summary><p>Fill in the form above and tap Send. WhatsApp opens with your details, and we reply there.</p></details>
<details><summary>What is a subdomain-only site?</summary><p>Your site goes live on a free address such as yourname.vercel.app instead of your own .com, .net or .online domain.</p></details>
<details><summary>Can I add my own domain later?</summary><p>Yes. Message us on WhatsApp and we’ll set it up.</p></details>
</div></div>
</div></section>

<section class="pg" id="affiliates"><div class="w">
<div class="hero"><span class="tag">Open to everyone · closes at 50 affiliates</span>
<h1><span class="ln" style="--i:0"><span>Refer a client.</span></span><span class="ln" style="--i:1"><span class="g">Get paid.</span></span></h1>
<p class="sub">Our affiliate system is very simple. No matter who you are, you get paid when a client you referred signs up.</p>
<div class="row"><button class="btn p" data-go="apply">Become an affiliate</button><button class="btn" data-go="team">Sales teams: partner with us</button></div></div>

<div class="grid" id="pay"></div>

<div class="sec"><div class="xmas rv"><h2>Best affiliate wins a Christmas gift.</h2><p id="xp"></p></div></div>

<div class="sec"><h2 class="rv">How it works</h2><div class="steps rv" id="s2"></div></div>

<div class="sec" id="team"><span class="tag">For sales teams and agencies</span>
<h2 class="rv">Got a sales team? Let’s work together.</h2>
<p class="g" id="team_p" style="max-width:620px;margin:14px 0 0"></p>
<div class="grid" id="team_tiers" style="margin-top:30px"></div>
<div class="grid" style="margin-top:16px;align-items:start">
<div class="card"><h3>Estimate your team’s pay</h3><p>Enter how many paying clients your team could bring in by the deadline.</p>
<label style="margin-top:16px">Paying clients<input id="t_c" inputmode="numeric" value="150"></label>
<div class="est" style="margin-top:14px"><span id="t_l2">Estimated pay</span><b id="t_e"></b></div>
<p class="g" style="font-size:13px" id="t_note"></p></div>
<div class="card"><h3>What we’re looking for</h3><ul class="rules"><li>A team or agency with a real sales process, not just one person.</li><li>Able to bring in at least 150 paying clients by 31 December 2026.</li><li>Clients are real and each one pays in full.</li><li>Your team uses the same prices and packages as everyone else.</li><li>You share each client’s name and phone number with us when they order.</li><li>Sales teams are separate from the 50-member individual affiliate list.</li></ul></div>
</div>
<div class="card" style="margin-top:16px"><h3>Apply as a sales team</h3><p class="g">Tell us about your team. We’ll review it and reply on WhatsApp with the next steps and a short written agreement.</p>
<form id="tf" novalidate style="margin-top:20px">
<label>Team or agency name<input id="t_n"></label>
<label>Team lead’s name<input id="t_o" autocomplete="name"></label>
<label>WhatsApp number<input id="t_p" inputmode="tel" autocomplete="tel"></label>
<label>People on your team<input id="t_s" inputmode="numeric"></label>
<label class="f">Clients you can bring in by 31 December<select id="t_t"><option value="">Choose one</option><option>150 to 299</option><option>300 to 499</option><option>500 or more</option></select></label>
<label class="f">How does your team sell, and where? (30+ characters)<textarea id="t_m"></textarea></label>
<div class="err" id="t_x"></div>
<button class="btn p f" type="submit">Apply on WhatsApp</button>
</form></div></div>

<div class="sec" id="apply"><div class="grid" style="align-items:start">
<div class="card"><h3>Apply to join</h3><p class="g">We use this to keep out spam and unserious applications. The affiliate team closes once it reaches 50 members, so apply early.</p>
<form id="af" novalidate style="margin-top:20px;grid-template-columns:1fr">
<label>Full name<input id="a_n" autocomplete="name"></label>
<label>WhatsApp number<input id="a_p" inputmode="tel"></label>
<label>Where will you promote?<select id="a_w"><option value="">Choose one</option><option>WhatsApp status/groups</option><option>Instagram</option><option>TikTok</option><option>Facebook</option><option>X (Twitter)</option><option>In person / network</option></select></label>
<label>How many people can you reach?<input id="a_a" inputmode="numeric"></label>
<label>Why should we approve you? (30+ characters)<textarea id="a_y"></textarea></label>
<label>Quick check: <span id="cq"></span><input id="a_c" inputmode="numeric"></label>
<label style="display:flex;gap:10px;align-items:flex-start;font-weight:400"><input type="checkbox" id="a_k" style="width:20px;min-height:20px;margin-top:3px">I agree to the rules and understand fake referrals are disqualified.</label>
<button class="btn p" id="a_b" type="submit" disabled>Apply on WhatsApp</button>
</form>
<div class="dash" id="dash"><b>You’re in. Your referral code:</b><code id="d_c"></code><b>Your referral link:</b><code id="d_l"></code>
<div class="row"><button class="btn" id="d_cp">Copy link</button><button class="btn p" id="d_sh">Share on WhatsApp</button></div>
<p class="g" style="margin-bottom:0">Send the link to your client, or ask them to mention your code when ordering.</p></div></div>
<div style="display:grid;gap:16px">
